# Endereço do servidor de sincronização usado pelo app Android (no web, o app usa a própria origem).
# Exemplo de produção: https://studyroutine.j2bot.com.br
VITE_SYNC_ORIGIN=https://studyroutine.j2bot.com.br

# Só para testes: permite simular a data com ?hoje=AAAA-MM-DD. Deixe vazio em produção.
VITE_ALLOW_DATE_OVERRIDE=
