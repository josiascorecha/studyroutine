# Copie para deploy/.env na VPS (NUNCA versione o .env real) e preencha.
# Gere segredos com:  openssl rand -hex 32   (hex evita caracteres especiais na URL do banco)

# Endereço público (HTTPS) do StudyRoutine. É também a origem liberada no CORS.
APP_ORIGIN=https://studyroutine.exemplo.com.br
# Porta local (só 127.0.0.1). Confira com scripts/inspect-vps.sh se está livre.
APP_PORT=8088
APP_VERSION=latest

POSTGRES_PASSWORD=troque-por-um-segredo-longo
# Usado para transformar o IP em código irreversível nos limites de uso. Mínimo 32 caracteres.
IP_PEPPER=troque-por-outro-segredo-com-pelo-menos-32-caracteres

# Contato exibido na política de privacidade.
CONTACT_EMAIL=contato@exemplo.com.br
PRIVACY_VERSION=2026-10-04
LOG_LEVEL=info

# Origens extras liberadas no CORS (o app Android usa https://localhost).
# EXTRA_ORIGINS=https://localhost,capacitor://localhost

# Limites por cofre (os padrões servem para uso pessoal)
# VAULT_MAX_BYTES=20971520
# VAULT_MAX_RECORDS=50000
# VAULT_INACTIVE_DAYS=548

# Backups
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=3
